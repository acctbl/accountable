{
  "name": "@accountable/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm i18n:compile && vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "pnpm i18n:compile && vite build",
    "preview": "vite preview",
    "format": "biome format",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "lint": "biome lint",
    "typecheck": "pnpm i18n:compile && tsc --noEmit",
    "check": "pnpm i18n:check && biome check && pnpm typecheck && vitest run",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore='**/*.d.ts' --ignore='**/*.test.ts' --ignore='**/*.test.tsx' --out-file src/i18n/messages/en.json",
    "i18n:compile": "formatjs compile-folder src/i18n/messages src/i18n/compiled --ast && formatjs compile src/i18n/messages/en.json --ast --pseudo-locale en-XA --out-file src/i18n/compiled/en-XA.json && formatjs compile src/i18n/messages/en.json --ast --pseudo-locale en-XB --out-file src/i18n/compiled/en-XB.json",
    "i18n:verify": "node scripts/verify-message-ids.mjs",
    "i18n:check": "node scripts/check-i18n-extraction.mjs && pnpm i18n:verify && node scripts/check-locale-completeness.mjs",
    "test": "pnpm i18n:extract && pnpm i18n:compile && vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "pnpm i18n:compile && vitest run --project component",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@accountable/proto": "workspace:*",
    "@accountable/ui": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-web": "^2.1.2",
    "@formatjs/intl-localematcher": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-intl": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@formatjs/cli": "^6.13.0",
    "@serwist/vite": "^9.5.12",
    "@serwist/window": "^9.5.12",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "^1.168.22",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "happy-dom": "catalog:",
    "serwist": "^9.5.12",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
