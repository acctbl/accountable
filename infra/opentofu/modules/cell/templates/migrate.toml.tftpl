schema_version = 1
revision = "${revision}"
environment = "${environment}"
deployment_mode = "managed"
cell_id = "${cell_id}"
aws_region = "${aws_region}"
runtime_role = "migrate"
foundation_check_timeout = "30s"
readiness_probe_interval = "10s"

[capabilities]
architecture_probe = false
postgres = true
secrets = true
kms = false
object_storage = false
telemetry = false
redpanda = false

[secrets]
provider = "infisical"
site_url = "https://eu.infisical.com"
aws_region = "${aws_region}"
project_id = "${infisical_project_id}"
environment = "${environment}"
secret_path = "${secret_path}"
auth_method = "aws_iam"
machine_identity_id = "${machine_identity_id}"

[postgres]
host = "${database_host}"
port = 5432
name = "accountable"
user = "accountable_migrate"
role = "accountable_migrate"
password_ref = "database/password"
tls_mode = "verify-full"
tls_root_ca_file = "/etc/ssl/certs/aws-rds-global-bundle.pem"
connect_timeout = "5s"
statement_timeout = "30s"
health_check_interval = "10s"
max_connections = 2
timezone = "UTC"

[time]
provider = "linux"
max_clock_error = "1s"
max_database_skew = "1s"
